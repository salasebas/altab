// docs: https://help.apple.com/xcode/mac/11.4/#/itcaec37c2a6

#include "base.xcconfig"

PRODUCT_NAME = AlTab Dev
PRODUCT_BUNDLE_IDENTIFIER = dev.salasebas.AlTabDev
// Canonical once-per-Mac identity (scripts/codesign/setup_local.sh). Shared by every worktree.
// Ad-hoc is only for explicit overrides / CI: CODE_SIGN_IDENTITY=-
CODE_SIGN_IDENTITY = Local Self-Signed
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG // for macro `#if DEBUG`
OTHER_SWIFT_FLAGS = -driver-time-compilation -Xfrontend -warn-long-function-bodies=250 -Xfrontend -warn-long-expression-type-checking=250 // find slow compilation areas
OTHER_CODE_SIGN_FLAGS = --timestamp=none
SWIFT_COMPILATION_MODE = incremental
ENABLE_DEBUG_DYLIB = NO // skip the debug dylib loader (we don't use SwiftUI Previews); silences [PreviewsAgentExecutorLibrary] startup chatter

// Advanced per-developer overrides only (optional). Not required for the standard local path.
#include? "local.xcconfig"
